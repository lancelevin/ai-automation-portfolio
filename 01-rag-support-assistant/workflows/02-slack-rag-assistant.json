      "id": "91381320-de40-4568-8919-cf1b6126f620",
      "name": "Fetch Slack Thread Context"
    },
    {
      "parameters": {
        "jsCode": "const slack = $('Check Escalation State').first().json;\nconst response = $input.first().json ?? {};\n\nif (response.ok === false) {\n  throw new Error(`Slack conversations.replies failed: ${response.error || 'unknown_error'}`);\n}\n\nconst messages = Array.isArray(response.messages) ? response.messages : [];\n\nconst cleaned = messages.slice(-12).map((m) => {\n  const text = String(m.text || '')\n    .replace(/<@[^>]+>/g, '')\n    .replace(/\\s+/g, ' ')\n    .trim();\n\n  const role = m.bot_id || m.subtype === 'bot_message' ? 'ASSISTANT' : 'USER';\n\n  return {\n    role,\n    text,\n    ts: String(m.ts || '')\n  };\n}).filter(m => m.text);\n\nconst thread_context = cleaned\n  .map(m => `${m.role}: ${m.text}`)\n  .join('\\n');\n\nreturn [{\n  json: {\n    ...slack,\n    thread_context: thread_context || 'No previous thread context available.',\n    thread_message_count: cleaned.length\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -880,
        160
      ],
      "id": "e78fd565-7f2f-48a7-ac4d-bd6e265332f2",
      "name": "Build Slack Thread Context"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=You rewrite Slack follow-up messages into ONE standalone search question for an internal company knowledge base.\n\nUse the Slack thread only to understand what the user is referring to.\nDo NOT answer the user.\nDo NOT invent company facts.\nDo NOT add commentary.\nIf the latest message is already a clear standalone question, return it unchanged.\nIf it is a follow-up such as \"what else?\", \"tell me more\", \"what about that?\", or uses pronouns like \"it/that/they\", rewrite it so the topic is explicit.\n\nSLACK THREAD:\n{{ $json.thread_context }}\n\nLATEST USER MESSAGE:\n{{ $json.question }}\n\nReturn ONLY the standalone retrieval question.",
        "batching": {}
      },
