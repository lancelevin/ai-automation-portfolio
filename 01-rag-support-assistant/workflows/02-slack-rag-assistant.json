    {
      "parameters": {
        "jsCode": "const base = $('Build Slack Thread Context').first().json;\n\nlet raw = $json.text ?? $json.output ?? $json.response ?? $json.content ?? '';\nif (typeof raw !== 'string') raw = JSON.stringify(raw);\n\nconst search_question = raw\n  .trim()\n  .replace(/^```(?:text)?\\s*/i, '')\n  .replace(/\\s*```$/i, '')\n  .replace(/^[\"']|[\"']$/g, '')\n  .trim();\n\nreturn [{\n  json: {\n    ...base,\n    search_question: search_question || base.question\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
