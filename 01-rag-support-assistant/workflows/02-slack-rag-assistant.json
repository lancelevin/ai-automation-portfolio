      "name": "Anthropic - Classify Escalated Thread Message",
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 1500
    },
    {
      "parameters": {
        "jsCode": "const base = $('Build Slack Thread Context').first().json;\n\nlet raw = $json.text ?? $json.output ?? $json.response ?? $json.content ?? '';\nif (typeof raw !== 'string') raw = JSON.stringify(raw);\n\nconst cleaned = raw\n  .trim()\n  .replace(/^```(?:text)?\\s*/i, '')\n  .replace(/\\s*```$/i, '')\n  .replace(/[^A-Z_]/gi, '')\n  .toUpperCase();\n\nconst escalation_intent =\n  cleaned === 'CASE_FOLLOWUP'\n    ? 'CASE_FOLLOWUP'\n    : 'NEW_TOPIC';\n\nreturn [{\n  json: {\n    ...base,\n    escalation_intent\n  }\n}];"
      },
