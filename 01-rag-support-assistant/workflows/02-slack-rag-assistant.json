    {
      "parameters": {
        "promptType": "define",
        "text": "=You are the Northstar Business Knowledge Assistant.\n\nYour job is to answer the user's question using ONLY the retrieved business knowledge shown below.\n\nRULES:\n1. Do not use outside knowledge for company-specific facts.\n2. Use the Slack thread only to understand conversational references.\n3. Company facts must be supported by RETRIEVED BUSINESS KNOWLEDGE.\n4. If the retrieved context directly supports the answer, return status \"ANSWER\".\n5. If the context does not directly support the answer, is ambiguous, or is insufficient, return status \"ESCALATE\".\n6. Never invent policies, procedures, benefits, rules, versions, filenames, URLs, or citations.\n7. Keep answers clear and concise.\n8. Do not add a Sources section yourself. The workflow will append verified source metadata.\n9. Return ONLY valid JSON. No markdown fences and no extra commentary.\n\nReturn this exact JSON shape:\n{\n  \"status\": \"ANSWER\" or \"ESCALATE\",\n  \"answer\": \"Concise answer when supported, otherwise an empty string\",\n  \"reason\": \"Short internal reason for the decision\"\n}\n\nCURRENT USER MESSAGE:\n{{ $json.question }}\n\nYOUR_SLACK_CHANNEL_ID-AWARE RETRIEVAL QUESTION:\n{{ $json.search_question }}\n\nRECENT SLACK THREAD:\n{{ $json.thread_context }}\n\nRETRIEVED BUSINESS KNOWLEDGE:\n{{ $json.context }}\n",
        "needsFallback": true,
        "batching": {}
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.7,
      "position": [
        496,
        256
      ],
      "id": "85a42d25-894a-4ad8-83df-218a12e747b8",
      "name": "Answerability + Answer",
      "retryOnFail": true,
      "maxTries": 4,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "modelName": "models/gemini-3.8-flash",
        "options": {
          "maxOutputTokens": 1024,
          "temperature": 0.2
        }
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1,
      "position": [
        496,
        496
      ],
      "id": "e7614bc3-c8a8-445d-93b0-e432d0324c82",
      "name": "Google Gemini Chat Model"
    },
    {
      "parameters": {
        "jsCode": "const base = $('Build Retrieval Context').first().json;\n\nlet raw = $json.text ?? $json.output ?? $json.response ?? $json.content ?? '';\nif (typeof raw !== 'string') raw = JSON.stringify(raw);\n\nlet cleaned = raw.trim()\n  .replace(/^```json\\s*/i, '')\n  .replace(/^```\\s*/i, '')\n  .replace(/\\s*```$/i, '')\n  .trim();\n\nlet parsed;\ntry {\n  parsed = JSON.parse(cleaned);\n} catch (error) {\n  parsed = {\n    status: 'ESCALATE',\n    answer: '',\n    reason: 'The answer model did not return valid structured JSON.'\n  };\n}\n\nconst status = String(parsed.status ?? 'ESCALATE').toUpperCase() === 'ANSWER'\n  ? 'ANSWER'\n  : 'ESCALATE';\n\nconst answer = typeof parsed.answer === 'string' ? parsed.answer.trim() : '';\nconst reason = typeof parsed.reason === 'string'\n  ? parsed.reason.trim()\n  : 'The approved knowledge base did not provide enough direct support.';\n\nconst sources = Array.isArray(base.sources) ? base.sources : [];\n\nconst sourceLines = sources\n  .map((s) => {\n    let label = `• ${s.document_title || s.source_file || 'Unknown document'}`;\n    if (s.document_version) label += ` — Version ${s.document_version}`;\n    if (s.source_file && s.source_file !== s.document_title) label += ` (${s.source_file})`;\n    if (s.source_url) label += `\\n  ${s.source_url}`;\n    return label;\n  })\n  .join('\\n');\n\nconst slackText = status === 'ANSWER'\n  ? `${answer}${sourceLines ? `\\n\\n*Sources:*\\n${sourceLines}` : ''}`\n  : `I couldn't find enough information in the approved business knowledge base to answer this confidently. This request needs human review.`;\n\nreturn [{\n  json: {\n    ...base,\n    status,\n    answer,\n    reason,\n    slack_text: slackText\n  }\n}];"
      },
