    {
      "parameters": {
        "jsCode": "const input = $input.first().json ?? {};\n\nconst store = $getWorkflowStaticData('global');\nstore.northstarEscalations = store.northstarEscalations || {};\n\nconst session_id = `${input.channel_id || 'no-channel'}:${input.thread_ts || 'no-thread'}`;\nconst existing = store.northstarEscalations[session_id] || null;\n\nreturn [{\n  json: {\n    ...input,\n    session_id,\n    already_escalated: Boolean(existing),\n    existing_case_id: existing?.case_id || '',\n    escalated_at: existing?.escalated_at || ''\n  }\n}];"
