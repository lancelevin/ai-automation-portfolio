        },
        "text": "={{ `I couldn’t find enough reliable information in the approved knowledge base, so I’m escalating this request.\\n\\nHi <@HUMAN_REVIEWER_USER_ID>, could you help our user here?\\n\\n*Case number:* \\`${$json.case_id}\\`` }}",
