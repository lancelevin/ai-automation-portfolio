      "id": "7b6f7ddb-807e-420f-a915-d0161cfca289",
      "name": "Embeddings Google Gemini"
    },
    {
      "parameters": {
        "jsCode": "const input = $input.all();\nconst slack = $('Use Rewritten Retrieval Question').first().json;\n\nconst chunks = [];\nconst sourceMap = new Map();\n\nfor (const item of input) {\n  const raw = item.json ?? {};\n  const doc = raw.document ?? raw;\n  const pageContent = doc.pageContent ?? raw.pageContent ?? doc.content ?? raw.content ?? '';\n  const metadata = doc.metadata ?? raw.metadata ?? {};\n  const score = raw.score ?? raw.similarityScore ?? doc.score ?? null;\n\n  if (!pageContent) continue;\n\n  chunks.push({\n    text: pageContent,\n    metadata,\n    score\n  });\n\n  const key =\n    metadata.google_drive_file_id ??\n    metadata.source_file ??\n    metadata.document_title ??\n    JSON.stringify(metadata);\n\n  if (!sourceMap.has(key)) {\n    sourceMap.set(key, {\n      document_title: metadata.document_title ?? metadata.source_file ?? 'Unknown document',\n      document_version: metadata.document_version ?? '',\n      source_file: metadata.source_file ?? '',\n      source_url: metadata.source_url ?? '',\n      domain: metadata.domain ?? '',\n      document_type: metadata.document_type ?? ''\n    });\n  }\n}\n\nconst context = chunks.map((chunk, index) => {\n  const m = chunk.metadata ?? {};\n  return [\n    `[CHUNK ${index + 1}]`,\n    chunk.text,\n    `SOURCE_TITLE: ${m.document_title ?? m.source_file ?? 'Unknown document'}`,\n    `SOURCE_FILE: ${m.source_file ?? ''}`,\n    `DOCUMENT_VERSION: ${m.document_version ?? ''}`,\n    `SOURCE_URL: ${m.source_url ?? ''}`,\n    chunk.score !== null ? `SIMILARITY_SCORE: ${chunk.score}` : ''\n  ].filter(Boolean).join('\\n');\n}).join('\\n\\n---\\n\\n');\n\nreturn [{\n  json: {\n    ...slack,\n    retrieved_count: chunks.length,\n    context,\n    sources: Array.from(sourceMap.values())\n  }\n}];"
      },
