    {
      "parameters": {
        "jsCode": "const item = $input.first().json ?? {};\n\nconst caseText = item.existing_case_id\n  ? ` under case \\`${item.existing_case_id}\\``\n  : '';\n\nreturn [{\n  json: {\n    ...item,\n    followup_message:\n      `This request is already with our Service Desk${caseText}.\\n\\n` +\n      `Hi <@HUMAN_REVIEWER_USER_ID>, could you continue assisting our user here?`\n  }\n}];"
