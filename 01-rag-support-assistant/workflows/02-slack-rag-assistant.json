    {
      "parameters": {
        "jsCode": "const item = $input.first().json ?? {};\n\nconst store = $getWorkflowStaticData('global');\nstore.northstarEscalations = store.northstarEscalations || {};\n\nconst session_id = `${item.channel_id || 'no-channel'}:${item.thread_ts || 'no-thread'}`;\n\nif (!item.case_id) {\n  throw new Error('Human escalation workflow did not return case_id.');\n}\n\nstore.northstarEscalations[session_id] = {\n  case_id: String(item.case_id),\n  escalated_at: new Date().toISOString()\n};\n\nreturn [{\n  json: {\n    ...item,\n    session_id,\n    escalation_state_saved: true\n  }\n}];"
